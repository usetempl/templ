{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/render-share-art.mjs && next dev -p 6969",
    "build": "node scripts/render-share-art.mjs && next build --webpack && node ../scripts/src/release/scan-client-bundle.mjs --forbid-manifest-secrets --dir .next/static --dir public",
    "start": "next start",
    "lint": "eslint src next.config.ts open-next.config.ts vitest.config.ts",
    "format": "prettier --write . --ignore-path ../../.gitignore",
    "type-check": "next typegen && tsc --noEmit",
    "test": "vitest run src/lib/public-hosted-support.test.ts --maxWorkers=2"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "@solana/spl-token": "0.4.14",
    "@solana/web3.js": "1.98.4",
    "@tabler/icons-react": "3.36.1",
    "@templ/chat": "workspace:*",
    "@templ/e2ee": "workspace:*",
    "buffer": "6.0.3",
    "next": "16.4.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "viem": "2.55.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.12",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "happy-dom": "^20.11.6",
    "postcss": "^8",
    "sharp": "0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.12",
    "wrangler": "^4"
  }
}
