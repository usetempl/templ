{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 6969",
    "build": "next build --webpack && node ../scripts/src/release/scan-client-bundle.mjs --forbid-manifest-secrets --dir .next/static --dir public",
    "start": "next start",
    "lint": "eslint src next.config.ts open-next.config.ts vitest.config.ts",
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "type-check": "next typegen && tsc --noEmit",
    "test": "vitest run src/lib/community-auth.test.ts src/lib/support-widget-frame-host.test.ts src/lib/support-widget-frame.test.ts src/lib/support-widget-snapshot.test.tsx src/lib/support-widget-drafts.test.ts src/components/product-checkout.test.tsx src/components/product-payment-request.test.tsx src/components/workspace/plan-finance-email.test.tsx --maxWorkers=2",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy:staging": "make -C ../.. deploy-staging-web",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@solana/spl-token": "0.4.14",
    "@solana/web3.js": "1.98.4",
    "@tabler/icons-react": "3.36.1",
    "@templ/chat": "workspace:*",
    "@templ/e2ee": "workspace:*",
    "buffer": "6.0.3",
    "next": "16.4.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "viem": "2.55.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.12",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "happy-dom": "^20.11.6",
    "postcss": "^8",
    "sharp": "0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.12",
    "wrangler": "^4"
  }
}
